APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resume_screener

# LLM_PROVIDER options: mock | gemini | openai | anthropic | groq | openrouter | ollama
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Only needed to override the default endpoint (e.g. custom Ollama host)
LLM_BASE_URL=

MAX_UPLOAD_SIZE_MB=10
