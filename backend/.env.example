APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resume_screener

LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

MAX_UPLOAD_SIZE_MB=10

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

#Notification-------------

NOTIFICATIONS_ENABLED=false
AUTO_UPDATE_CANDIDATE_STATUS=true

EMAIL_PROVIDER=none
# Options: none | smtp | sendgrid

# --- SMTP (e.g. Gmail with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=you@gmail.com
SMTP_USE_TLS=true

# --- SendGrid (alternative to SMTP) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

SHORTLIST_SCORE_THRESHOLD=70
REJECT_SCORE_THRESHOLD=40
SCHEDULE_LINK_SCORE_THRESHOLD=80

CALCOM_SCHEDULING_URL=https://cal.com/your-username/interview
COMPANY_NAME=Your Company Name